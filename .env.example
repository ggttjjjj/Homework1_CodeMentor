# ================================================
# CodeMentor 配置模板
# 使用方法：复制本文件为 .env（保持等号格式），填入你自己的密钥
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# 优先级：系统环境变量 > .env > config.json > 内置默认值
# ================================================

# ===== 必填：API Key =====
CODEMENTOR_API_KEY=sk-在这里填入你的密钥

# ===== 协议与端点（按你的服务商选择一组，取消注释）=====
# 提示：Web 配置向导（python web.py）内置 24 项分组预设，选中即自动填充，
# 下面的注释仅作速查。protocol: openai=绝大多数服务商 | anthropic=Claude/智谱套餐

# --- 智谱 GLM Coding 套餐（Lite/Pro，推荐，额度走此端点）---
# CODEMENTOR_PROTOCOL=anthropic
# CODEMENTOR_BASE_URL=https://open.bigmodel.cn/api/anthropic
# CODEMENTOR_MODEL=glm-5.3-flash

# --- 智谱 GLM 按量付费 / 免费档 ---
# CODEMENTOR_PROTOCOL=openai
# CODEMENTOR_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# CODEMENTOR_MODEL=glm-4.5-flash

# --- DeepSeek / 通义千问 / Kimi ---
# CODEMENTOR_BASE_URL=https://api.deepseek.com/v1            MODEL=deepseek-chat
# CODEMENTOR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  MODEL=qwen-plus
# CODEMENTOR_BASE_URL=https://api.moonshot.cn/v1             MODEL=kimi-k2-turbo-preview

# --- 豆包(方舟) / 文心(千帆) / 混元 / 星火 / MiniMax / 阶跃 / 零一 ---
# CODEMENTOR_BASE_URL=https://ark.cn-beijing.volces.com/api/v3   MODEL=doubao-seed-1.6
# CODEMENTOR_BASE_URL=https://qianfan.baidubce.com/v2            MODEL=ernie-4.5-turbo-8k
# CODEMENTOR_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1   MODEL=hunyuan-turbos-latest
# CODEMENTOR_BASE_URL=https://spark-api-open.xf-yun.com/v1       MODEL=4.0Ultra
# CODEMENTOR_BASE_URL=https://api.minimax.chat/v1                MODEL=MiniMax-M1
# CODEMENTOR_BASE_URL=https://api.stepfun.com/v1                 MODEL=step-2-16k
# CODEMENTOR_BASE_URL=https://api.lingyiwanwu.com/v1             MODEL=yi-lightning

# --- 国际：OpenAI / Claude / Gemini / Grok / Mistral ---
# CODEMENTOR_BASE_URL=https://api.openai.com/v1              MODEL=gpt-4o-mini
# CODEMENTOR_PROTOCOL=anthropic
# CODEMENTOR_BASE_URL=https://api.anthropic.com              MODEL=claude-sonnet-4-5
# CODEMENTOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  MODEL=gemini-2.5-flash
# CODEMENTOR_BASE_URL=https://api.x.ai/v1                    MODEL=grok-4
# CODEMENTOR_BASE_URL=https://api.mistral.ai/v1              MODEL=mistral-large-latest

# --- 聚合：硅基流动 / OpenRouter / Groq ---
# CODEMENTOR_BASE_URL=https://api.siliconflow.cn/v1          MODEL=deepseek-ai/DeepSeek-V3
# CODEMENTOR_BASE_URL=https://openrouter.ai/api/v1           MODEL=openai/gpt-4o-mini
# CODEMENTOR_BASE_URL=https://api.groq.com/openai/v1         MODEL=llama-3.3-70b-versatile

# --- 本地：Ollama / LM Studio / vLLM ---
# CODEMENTOR_BASE_URL=http://localhost:11434/v1              MODEL=qwen2.5-coder:7b
# CODEMENTOR_BASE_URL=http://localhost:1234/v1               MODEL=(LM Studio 已加载的模型)
# CODEMENTOR_BASE_URL=http://localhost:8000/v1               MODEL=(vLLM 服务的模型)

# ===== 可选：Agent 行为微调（删掉即用默认值）=====
# CODEMENTOR_MAX_ITERATIONS=8        # 单次任务最大推理轮数
# CODEMENTOR_REQUEST_TIMEOUT=180     # LLM 请求超时（秒）；大任务生成较慢可再调大
# CODEMENTOR_MEMORY_CHARS=24000      # 上下文记忆预算（字符）
# CODEMENTOR_WORKSPACE=.             # 工具可访问的工作区根目录
